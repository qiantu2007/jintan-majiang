            (wr.after < 0 ? '<span class="wb-debt">欠账</span>' : "") + "</div>";
    if (rankUp || rankDown) {
      h += '<div class="wb-rank ' + (rankUp ? "up" : "down") + '">称号 ' + wr.rankBefore +
           (rankUp ? " ↗ " : " ↘ ") + wr.rankAfter + "</div>";
