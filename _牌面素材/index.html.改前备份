    var order = [game.dealer, (game.dealer + 1) % 4, (game.dealer + 2) % 4, (game.dealer + 3) % 4];
    for (var i = 0; i < 4; i++) {
      var r = await replaceFlowers(game.players[order[i]]);
      if (r !== "ok") return;
      if (!still(g)) return;
    }
    game.current = game.dealer;
    game.needDraw = false;
    game.drewThisTurn = true;
    game.phase = "discard";
    saveGame();
    render();
    await turnLoop();
  }

  function continueSaved() {
    var d = loadGame();
